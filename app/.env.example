# Configuração da aplicação (copiar para .env e ajustar)
# As variáveis de ambiente sobrepõem os valores do config.json.
# Em produção, define estas variáveis no servidor (Apache/Nginx ou sistema).

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sgreserva
